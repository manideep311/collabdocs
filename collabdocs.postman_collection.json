    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List audit logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audit-logs/?actor={{user_id}}&from=2026-01-01&to=2030-01-01",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "audit-logs"
              ],
              "query": [
                {
                  "key": "actor",
                  "value": "{{user_id}}",
                  "disabled": false
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": false
                },
                {
                  "key": "to",
                  "value": "2030-01-01",
                  "disabled": false
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
